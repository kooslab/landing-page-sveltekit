@import '@fontsource-variable/geist';

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		/* Dark-first — Basement Studio aesthetic */
		--background: 0 0% 4%;
		--foreground: 0 0% 94%;

		--muted: 0 0% 8%;
		--muted-foreground: 0 0% 45%;

		--popover: 0 0% 5%;
		--popover-foreground: 0 0% 94%;

		--card: 0 0% 6%;
		--card-foreground: 0 0% 94%;

		--border: 0 0% 13%;
		--input: 0 0% 13%;

		--primary: 0 0% 94%;
		--primary-foreground: 0 0% 4%;

		--secondary: 0 0% 10%;
		--secondary-foreground: 0 0% 94%;

		--accent: 0 0% 10%;
		--accent-foreground: 0 0% 94%;

		--destructive: 0 63% 40%;
		--destructive-foreground: 0 0% 94%;

		--ring: 270 85% 84%;

		--radius: 0.375rem;
	}
}

@layer base {
	* {
		@apply border-border;
	}
	html {
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	body {
		@apply bg-background text-foreground;
	}
}
